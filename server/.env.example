# Copiá este archivo como .env y completá los valores reales.
# El .env NO se sube al repositorio.

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodiebyte_db
DB_USER=root
DB_PASSWORD=

# --- Seguridad ---
# Clave para firmar los JWT. Generá una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=24h

# --- Servidor ---
PORT=3000
# Origen del frontend habilitado para CORS (separar con comas si hay varios)
CORS_ORIGIN=http://localhost:5173

# --- Negocio ---
# Comisión que cobra la plataforma sobre cada venta concretada (0.05 = 5%)
COMISION_PLATAFORMA=0.05

# --- Seeder del administrador inicial ---
ADMIN_EMAIL=admin@foodiebyte.com
ADMIN_PASSWORD=cambiame-en-el-primer-login
