# Copiá este archivo como .env y completá los valores reales.
# El .env NO se sube al repositorio.

# --- Base de datos (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=foodiebyte_db
DB_USER=postgres
DB_PASSWORD=
# Poné true solo si tu PostgreSQL exige TLS (Neon, Supabase, Railway...).
DB_SSL=false

# --- Seguridad ---
# Clave para firmar los JWT. Generá una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=24h

# --- Servidor ---
PORT=3000
# Origen del frontend habilitado para CORS (separar con comas si hay varios)
CORS_ORIGIN=http://localhost:5173

# --- Negocio ---
# Comisión que cobra la plataforma sobre cada venta concretada (0.05 = 5%)
COMISION_PLATAFORMA=0.05

# --- Seeder del administrador inicial ---
ADMIN_EMAIL=admin@foodiebyte.com
ADMIN_PASSWORD=cambiame-en-el-primer-login
DEMO_PASSWORD=cambiame-tambien

# --- Migración desde MySQL (solo para scripts/migrar-mysql-a-postgres.js) ---
# Datos de la base MySQL/MariaDB de origen. Se usan una única vez.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_NAME=foodiebyte_db
MYSQL_USER=root
MYSQL_PASSWORD=
