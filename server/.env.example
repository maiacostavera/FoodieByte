# Copiá este archivo como .env y completá los valores reales.
# El .env NO se sube al repositorio.

# --- Base de datos (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=foodiebyte_db
# Base aparte que usan las pruebas (npm test). La crea npm run setup.
DB_NAME_TEST=foodiebyte_test
DB_USER=postgres
DB_PASSWORD=
# Poné true solo si tu PostgreSQL exige TLS (Neon, Supabase, Railway...).
DB_SSL=false

# --- Seguridad ---
# Clave para firmar los JWT. Generá una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=24h

# --- Servidor ---
PORT=3000
# Origen del frontend habilitado para CORS (separar con comas si hay varios)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Negocio ---
# Comisión que cobra la plataforma sobre cada venta concretada (0.05 = 5%)
COMISION_PLATAFORMA=0.05
# Zona horaria con la que se agrupan las ventas por día en los paneles
ZONA_HORARIA=America/Argentina/Buenos_Aires

# --- Cuentas de la demo (las crean los seeders) ---
# ADMIN_PASSWORD es la del administrador y DEMO_PASSWORD la de todas las demás
# cuentas de ejemplo (locales y clientes). Sirven para correr la demo en tu
# compu; si publicás la aplicación en un servidor, cambialas antes de cargar datos.
ADMIN_EMAIL=admin@foodiebyte.com
ADMIN_PASSWORD=admin1234
DEMO_PASSWORD=demo1234

# --- Migración desde MySQL (solo para scripts/migrar-mysql-a-postgres.js) ---
# Datos de la base MySQL/MariaDB de origen. Se usan una única vez.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_NAME=foodiebyte_db
MYSQL_USER=root
MYSQL_PASSWORD=
