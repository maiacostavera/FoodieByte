{
  "name": "foodiebyte-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:create": "sequelize db:create",
    "db:check": "node scripts/verificar-conexion.js",
    "db:migrate": "sequelize db:migrate",
    "db:seed": "sequelize db:seed:all",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "db:reset": "sequelize db:drop && npm run db:setup",
    "db:test:create": "sequelize db:create --env test",
    "pretest": "sequelize db:migrate --env test",
    "test": "node pruebas/pruebas-api.js",
    "migrar:mysql": "node scripts/migrar-mysql-a-postgres.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API REST de FoodieByte (Node.js + Express + Sequelize + PostgreSQL)",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "mysql2": "^3.24.3",
    "sequelize-cli": "^6.6.5"
  }
}
